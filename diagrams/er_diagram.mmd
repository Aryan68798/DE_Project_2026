    CITIES {
        int city_id PK
        varchar city_name
        varchar state
    }

    SERVICE_CATEGORIES {
        int category_id PK
        varchar category_name
    }

    SERVICES {
        int service_id PK
        int category_id FK
        varchar service_name
        int duration_min
        numeric base_price
        boolean is_active
    }

    PROFESSIONALS {
        int pro_id PK
        varchar full_name
        varchar phone
        int city_id FK
        char gender
        date joined_on
        numeric rating
        boolean kyc_verified
        varchar status
    }

    PRO_SKILLS {
        int pro_id PK, FK
        int category_id PK, FK
        date certified_on
    }

    PRO_AVAILABILITY {
        int pro_id PK, FK
        date work_date PK
        time start_time
        time end_time
    }

    CUSTOMERS {
        int customer_id PK
        varchar full_name
        varchar phone
        varchar email
        int city_id FK
        date plus_valid_until
        timestamptz created_at
    }

    BOOKINGS {
        bigint booking_id PK
        int customer_id FK
        int service_id FK
        int pro_id FK
        int city_id FK
        varchar pincode
        timestamptz booked_at
        timestamptz scheduled_start
        timestamptz scheduled_end
        varchar status
        numeric price
        numeric discount
        numeric cancellation_fee
        numeric tip
        varchar payment_method
    }

    RESCHEDULES {
        int reschedule_id PK
        bigint booking_id FK
        timestamptz old_start
        timestamptz new_start
        varchar requested_by
        text reason
        timestamptz created_at
    }

    REVIEWS {
        bigint booking_id PK, FK
        smallint rating_for_pro
        text comment
        smallint rating_for_customer
        timestamptz created_at
    }

    PAYOUTS {
        bigint payout_id PK
        int pro_id FK
        date week_start
        int jobs
        numeric gross_earnings
        numeric commission
        numeric net_payout
        varchar status
        timestamptz paid_at
    }
